{
  "name": "nikkibase-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run build:ideal && tsc -b && vite build && node scripts/notices.mjs && node scripts/compress.mjs",
    "preview": "vite preview",
    "build:wasm": "cd .. && GOOS=js GOARCH=wasm go build -ldflags=\"-s -w\" -o web/src/generated/nikkibase.wasm ./wasm",
    "build:ideal": "cd .. && go run ./cmd/ideal -data web/public/data -out web/src/generated/ideal.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "antd": "^5.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
